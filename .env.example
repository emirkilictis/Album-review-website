# Copy this file to .env.local and fill it in.

# Password for /admin (pick something long).
ADMIN_PASSWORD=change-me

# Optional extra secret mixed into the login cookie signature.
SESSION_SECRET=

# Database. Locally a SQLite file is used. In production use a free Turso DB:
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Public URL of the site (used in RSS, sitemap and share previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
